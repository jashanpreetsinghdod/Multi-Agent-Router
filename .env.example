# ─────────────────────────────────────────────────────────────────────────────
# OmniRouter — environment variables
#
# Copy this to apps/web/.env.local (Next.js reads env files from the app
# folder, not the repo root) and fill in values.
#
# NOTE: users' own LLM API keys (Anthropic / OpenAI / Google / compatible)
# do NOT go here. Users paste those into Settings in the website; that is
# the whole BYOK idea. Nothing below is an LLM provider key.
# ─────────────────────────────────────────────────────────────────────────────


# ── NEEDED NOW ───────────────────────────────────────────────────────────────

# Live web search for the `web_search` tool (fixes the "model cutoff" problem).
# Get a key at https://tavily.com (free tier available).
# If empty: web_search is hidden from models; fetch_url and get_current_time still work.
TAVILY_API_KEY=

# Lets users point an "OpenAI-compatible" key at a private/localhost URL
# (Ollama, LM Studio, vLLM on your LAN). Keep "false" on any public deployment,
# otherwise users can make the server call internal addresses (SSRF).
ALLOW_PRIVATE_BASE_URLS=false


# ── DATABASE (Neon / Postgres) ───────────────────────────────────────────────

# PostgreSQL. When set, API keys (encrypted), conversations, router keys and
# per-attempt logs are stored here. Create tables once with: npm run db:migrate
# Free hosted option: https://neon.tech   Local: docker run -p 5432:5432 postgres:17
# Leave EMPTY to run without a database (everything kept in memory, lost on restart).
# Any value here switches the app to Postgres, so never leave a placeholder.
# Neon format: postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Master key (KEK) that wraps every per-credential encryption key in the vault
# (packages/crypto). REQUIRED when DATABASE_URL is set. Exactly 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this = every stored user API key becomes unreadable. Never commit it.
# In production, replace with a cloud KMS key.
OMNIROUTER_MASTER_KEY=


# ── NEEDED FOR LOGIN (Better Auth, not built yet) ────────────────────────────

# Random secret used to sign auth sessions. Generate like the master key.
BETTER_AUTH_SECRET=
# Public URL of the site.
BETTER_AUTH_URL=http://localhost:3000

# Optional social login providers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── NEEDED FOR PRODUCTION SCALE (later milestones) ───────────────────────────

# Redis: shared provider-health / circuit-breaker state across servers, rate
# limits. Free hosted option: https://upstash.com
REDIS_URL=

# Error tracking (keys are redacted before sending).
SENTRY_DSN=
